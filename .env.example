# Any OpenAI-compatible endpoint (OpenAI, OpenRouter, a local router, etc.)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Optional model per reasoning mode: AI_MODEL_LOW, AI_MODEL_MEDIUM, AI_MODEL_HIGH, AI_MODEL_EXTRA, AI_MODEL_MAX, AI_MODEL_ULTRA
AI_TIMEOUT_MS=90000
AI_RETRIES=3

# Optional: web search + reading JavaScript pages (https://tavily.com)
TAVILY_API_KEY=

# Optional: rename the assistant or replace its persona
KENT_NAME=Kent
KENT_SYSTEM_PROMPT=
# Name shown in the mode picker
NEXT_PUBLIC_KENT_MODEL_NAME=Kent
